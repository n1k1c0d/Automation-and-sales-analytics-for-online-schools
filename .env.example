# Скопируйте этот файл в .env и задайте локальный пароль PostgreSQL.
# POSTGRES_HOST и POSTGRES_PORT используются Python при запуске на хосте.
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Облачная AI-модель GroqCloud
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_INPUT_CHARS=24000
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_CLASSIFICATION_MAX_OUTPUT_TOKENS=2048
GROQ_SUMMARY_MAX_OUTPUT_TOKENS=2048

# Необязательные тарифы в долларах за миллион токенов
# GROQ_INPUT_USD_PER_MILLION=
# GROQ_CACHED_INPUT_USD_PER_MILLION=
# GROQ_OUTPUT_USD_PER_MILLION=
