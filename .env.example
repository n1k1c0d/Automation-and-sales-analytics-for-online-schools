# Скопируйте этот файл в .env и задайте локальный пароль PostgreSQL.
# POSTGRES_HOST и POSTGRES_PORT используются Python при запуске на хосте.
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# OpenAI используется при запуске AI-проверки и вызове LLM-клиента.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_INPUT_CHARS=24000
OPENAI_MAX_OUTPUT_TOKENS=1024
# OPENAI_CLASSIFICATION_MAX_OUTPUT_TOKENS=
# OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
